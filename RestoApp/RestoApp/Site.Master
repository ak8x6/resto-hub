<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="RestoApp.Site" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><asp:ContentPlaceHolder ID="TitleContent" runat="server"></asp:ContentPlaceHolder> - RestoApp</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- FontAwesome CSS -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <asp:ContentPlaceHolder ID="HeadContent" runat="server">
    </asp:ContentPlaceHolder>
    <style>
        .navbar-brand {
            font-weight: bold;
            font-size: 1.5rem;
        }
        .footer {
            background-color: #343a40;
            color: #ffffff;
            padding: 20px 0;
            text-align: center;
        }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">
    <form id="form1" runat="server" class="d-flex flex-column flex-grow-1">
        <!-- Navigation Bar -->
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
            <div class="container">
                <a class="navbar-brand" href="~/Default.aspx" runat="server"><i class="fa-solid fa-utensils"></i> RestoApp</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="nav-link" href="~/Default.aspx" runat="server">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="~/ClientsView/Menu/Menu.aspx" runat="server">Menu</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="~/ClientsView/tables/Tables.aspx" runat="server">Reserve a Table</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="~/ClientsView/Feedbacks/Reviews.aspx" runat="server">Reviews</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-warning fw-bold" href="~/ClientsView/Cart/Cart.aspx" runat="server">
                                <i class="fa-solid fa-cart-shopping"></i> Cart (<%= RestoApp.CartManager.GetTotalCount() %>)
                            </a>
                        </li>
                        <% if (Session["UserId"] != null && Session["UserRole"] != null && Session["UserRole"].ToString() == "Admin") { %>
                        <li class="nav-item">
                            <a class="nav-link text-info fw-bold" href="~/AdminView/Dashboard/AdminDashboard.aspx" runat="server">
                                <i class="fa-solid fa-gauge-high"></i> Admin
                            </a>
                        </li>
                        <% } %>
                        <% if (Session["UserId"] == null) { %>
                        <li class="nav-item">
                            <a class="nav-link btn btn-primary text-white ms-3 px-3" href="~/Authentication/Login.aspx" runat="server">Login</a>
                        </li>
                        <% } else { %>
                        <li class="nav-item">
                            <asp:LinkButton ID="btnLogout" runat="server" CssClass="nav-link btn btn-outline-danger text-danger ms-3 px-3" OnClick="btnLogout_Click">
                                <i class="fa-solid fa-right-from-bracket"></i> Logout
                            </asp:LinkButton>
                        </li>
                        <% } %>
                    </ul>
                </div>
            </div>
        </nav>

        <!-- Main Content Area -->
        <main class="flex-grow-1">
            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>
        </main>

        <!-- Footer -->
        <footer class="footer mt-auto">
            <div class="container">
                <span>&copy; <%: DateTime.Now.Year %> RestoApp. All rights reserved.</span>
            </div>
        </footer>

        <!-- Bootstrap Bundle with Popper -->
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    </form>
</body>
</html>